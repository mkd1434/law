# ============================================================================
# 법령 및 행정규칙 통합 모니터링 시스템 - 환경 변수 설정 가이드
# ============================================================================
# 이 파일은 필수 환경 변수의 예시입니다.
# 실제 운영 환경에서는 .env 파일을 생성하고 아래 값들을 설정해주세요.

# ============================================================================
# 데이터베이스 설정
# ============================================================================
# MySQL/TiDB 연결 문자열 (필수)
# 형식: mysql://사용자:비밀번호@호스트:포트/데이터베이스
# 예: mysql://root:pass1234@localhost:3306/law_monitor
# 또는: mysql://root:pass1234@gateway05.us-east-1.prod.aws.tidbcloud.com:4000/fkv8picyyeivub8ydl78dt
DATABASE_URL=mysql://root:pass1234@localhost:3306/law_monitor

# ============================================================================
# 인증 및 보안 설정
# ============================================================================
# JWT 토큰 서명용 시크릿 키 (필수, 최소 32자 이상 권장)
JWT_SECRET=your-secret-key-min-32-characters-required

# ============================================================================
# OAuth 설정 (Manus 인증)
# ============================================================================
# Manus OAuth 애플리케이션 ID (필수)
VITE_APP_ID=your-manus-app-id

# OAuth 서버 기본 URL (필수)
OAUTH_SERVER_URL=https://api.manus.im

# OAuth 포털 URL (프론트엔드, 필수)
VITE_OAUTH_PORTAL_URL=https://auth.manus.im

# ============================================================================
# 국가법령정보 API 설정
# ============================================================================
# 국가법령정보 공동활용 API 인증값 (OC) (필수)
# 신청 후 발급받은 OC 코드를 입력하세요
LAW_API_OC=mkd1434

# 국가법령정보 API 기본 URL (필수)
LAW_API_BASE_URL=http://www.law.go.kr/DRF

# API 호출 간격 (밀리초) - 법제처 서버 보호용 (선택, 기본값: 1500)
LAW_API_DELAY_MS=1500

# API 배치 크기 (한 번에 처리할 항목 수) (선택, 기본값: 2)
LAW_API_BATCH_SIZE=2

# API 호출 재시도 횟수 (선택, 기본값: 3)
LAW_API_RETRY_COUNT=3

# ============================================================================
# 애플리케이션 설정
# ============================================================================
# 실행 환경 (development/production) (선택, 기본값: development)
NODE_ENV=development

# 서버 포트 (선택, 기본값: 3000)
PORT=3000

# 서버 호스트 (선택, 기본값: 0.0.0.0)
HOST=0.0.0.0

# ============================================================================
# 경로 설정 (Vite 설정용)
# ============================================================================
# 클라이언트 디렉토리 경로 (선택, 기본값: {PROJECT_ROOT}/client)
# 환경 변수가 없으면 자동으로 프로젝트 루트/client로 설정됨
CLIENT_DIR=

# 공유 코드 디렉토리 경로 (선택, 기본값: {PROJECT_ROOT}/shared)
SHARED_DIR=

# 정적 자산 디렉토리 경로 (선택, 기본값: {PROJECT_ROOT}/attached_assets)
ASSETS_DIR=

# 빌드 출력 디렉토리 경로 (선택, 기본값: {PROJECT_ROOT}/dist/public)
DIST_DIR=

# ============================================================================
# Manus 시스템 환경 변수 (자동 주입)
# ============================================================================
# 다음 환경 변수들은 Manus 시스템에서 자동으로 주입됩니다.
# 수동으로 설정할 필요가 없습니다.

# 프로젝트 소유자 정보
# OWNER_NAME=
# OWNER_OPEN_ID=

# Manus 내장 API 설정 (서버용)
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Manus 내장 API 설정 (프론트엔드용)
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=

# 분석 및 모니터링
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=

# ============================================================================
# 선택 사항 (필요시 설정)
# ============================================================================
# 로그 레벨 (debug/info/warn/error) (선택, 기본값: info)
LOG_LEVEL=info

# 데이터 수집 스케줄 (cron 형식) (선택, 기본값: 매일 자정)
# 형식: "초 분 시 일 월 요일" (cron 6-field format)
# 예: "0 0 * * *" = 매일 자정
SYNC_SCHEDULE=0 0 * * *

# 최근 변경이력 조회 기간 (일 단위) (선택, 기본값: 365)
HISTORY_DAYS=365

# ============================================================================
# 주의사항
# ============================================================================
# 1. 모든 경로 변수(CLIENT_DIR, SHARED_DIR 등)가 비어있으면 자동으로 기본값이 사용됩니다.
# 2. DATABASE_URL, JWT_SECRET, VITE_APP_ID는 필수 환경 변수입니다.
# 3. 프로덕션 환경에서는 반드시 보안 설정을 확인하세요.
# 4. API_OC 값은 법제처에 신청하여 발급받은 값을 사용하세요.
